{
  "_comment": "Everything build_offline_bundle.py vendors into vendor/. Windows tools come from conda-forge (micromamba creates ready-to-run win-64 folders); entries with repo null are skipped with a warning and ResearchMate uses its built-in engine.",
  "pip_python_version": "312",
  "torch_index": "https://download.pytorch.org/whl/cu128",
  "github_release_binaries": [
    {
      "name": "Ollama installer",
      "repo": "ollama/ollama",
      "asset": "^OllamaSetup\\.exe$",
      "dest": "installers",
      "extract": false,
      "optional_note": "official Ollama installer; only used if the user prefers it over the bundled Ollama"
    },
    {
      "name": "Better BibTeX for Zotero (.xpi)",
      "repo": "retorquere/zotero-better-bibtex",
      "asset": "^zotero-better-bibtex-.*\\.xpi$",
      "dest": "installers",
      "extract": false
    }
  ],
  "direct_downloads": [
    {
      "name": "Temurin 21 JRE (portable)",
      "url": "https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jre/hotspot/normal/eclipse",
      "file": "temurin-21-jre-win-x64.zip",
      "dest": "java/jre"
    },
    {
      "name": "LanguageTool server",
      "url": "https://languagetool.org/download/LanguageTool-stable.zip",
      "file": "LanguageTool-stable.zip",
      "dest": "java/LanguageTool"
    },
    {
      "name": "Zotero 7 installer (Windows x64)",
      "url": "https://www.zotero.org/download/client/dl?channel=release&platform=win-x64",
      "file": "Zotero_setup.exe",
      "dest": "installers",
      "extract": false
    }
  ],
  "repos": [
    {
      "name": "Harper",
      "repo": "Automattic/harper"
    },
    {
      "name": "Turnitout-Humanizer",
      "repo": null
    },
    {
      "name": "Vale",
      "repo": "errata-ai/vale"
    },
    {
      "name": "LanguageTool",
      "repo": "languagetool-org/languagetool",
      "snapshot": false,
      "why": "Java source (GROBID 1.7 GB incl. models) \u2014 not run by ResearchMate; enable to bundle as reference"
    },
    {
      "name": "XtraGPT",
      "repo": "nuojohnchen/XtraGPT"
    },
    {
      "name": "PaperDebugger",
      "repo": null
    },
    {
      "name": "PaperQA2",
      "repo": "Future-House/paper-qa"
    },
    {
      "name": "GROBID",
      "repo": "kermitt2/grobid",
      "snapshot": false,
      "why": "Java source (GROBID 1.7 GB incl. models) \u2014 not run by ResearchMate; enable to bundle as reference"
    },
    {
      "name": "RefChecker",
      "repo": "markrussinovich/refchecker"
    },
    {
      "name": "CiteScan",
      "repo": "aivolcano/CiteScan"
    },
    {
      "name": "Paper Analysis Utility",
      "repo": null
    },
    {
      "name": "check-citations",
      "repo": null
    }
  ],
  "csl_styles": [
    "apa",
    "ieee",
    "vancouver",
    "chicago-author-date",
    "nature",
    "acm-sig-proceedings"
  ],
  "csl_base": "https://raw.githubusercontent.com/citation-style-language/styles/master/",
  "hf_models": [
    {
      "name": "embeddings (PaperQA2 dense retrieval)",
      "repo": "sentence-transformers/all-MiniLM-L6-v2",
      "dest": "models/embeddings",
      "files": [
        "config.json",
        "model.safetensors",
        "tokenizer.json",
        "tokenizer_config.json",
        "vocab.txt",
        "special_tokens_map.json",
        "modules.json",
        "sentence_bert_config.json",
        "config_sentence_transformers.json",
        "1_Pooling/config.json"
      ]
    },
    {
      "name": "perplexity (Turnitout-Humanizer neural score)",
      "repo": "openai-community/gpt2",
      "dest": "models/perplexity",
      "files": [
        "config.json",
        "model.safetensors",
        "tokenizer.json",
        "vocab.json",
        "merges.txt",
        "generation_config.json",
        "tokenizer_config.json"
      ]
    }
  ],
  "ollama_models": [
    {
      "name": "llama3.1:8b (Q4_K_M GGUF, imported offline with `ollama create`)",
      "url": "https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/resolve/main/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf",
      "dest": "models/ollama/llama3.1-8b-instruct-Q4_K_M.gguf",
      "ml": true
    }
  ],
  "csl_sources": {
    "vancouver": "nlm-citation-sequence"
  },
  "conda": {
    "channel_url": "https://conda.anaconda.org/conda-forge",
    "cuda": "12.9",
    "tools": [
      "ollama=0.24.0=cuda_129*",
      "pandoc",
      "typst",
      "vale",
      "harper"
    ],
    "tools_gpu": [
      "llama.cpp=*=cuda129*"
    ],
    "python_runtime": [
      "python=3.12",
      "pip"
    ],
    "prune": [
      "Library/lib",
      "Library/include",
      "Library/nvvm",
      "Library/bin/nvrtc*",
      "Library/bin/harper-ls.exe",
      "conda-meta/history",
      "pkgs"
    ]
  }
}
